<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.springboot.lee.mapper.AdminMapper">
	
	<update id="updateStatusOfUserList">
		update user
		<set>
			<if test="status!=null">
				status = #{status},
			</if>
				del_flag = 0
		</set>
		<where>
			<foreach collection="useridList" open="id in( " close=")" item="id" separator=",">
				#{id}
			</foreach>
		</where>
		
	</update>
	
</mapper>